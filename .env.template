# ============================================================
# CPG Analytics Dashboard — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cpg_analytics
POSTGRES_USER=cpg_user
POSTGRES_PASSWORD=changeme_strong_password

# --- Redis (Celery broker & result backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROJECT_API_KEY=
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Kaggle (for dataset ingestion) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Ollama (RAG / AI explanations via MCP) ---
OLLAMA_HOST=http://localhost:11434

# --- Encryption ---
# Fernet key for encrypting secrets in DB (auto-generated on first run if absent)
ENCRYPTION_KEY=

# --- Application ---
LOG_LEVEL=INFO
# Set to "production" to enforce API key authentication
APP_ENV=development

# --- Rate Limiting ---
# Requests per minute per IP on API endpoints
PROJECT_RATE_LIMIT=100
